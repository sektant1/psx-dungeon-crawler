// The dungeon kit's atlas material and the descent-portal shader profile,
// mirrored from game/assets/materials/{kit,vfx}.material.
//
// The sample only sees its own asset root plus the engine's, so the portal
// station cannot reference a Game/ material. Rather than approximate it with
// the engine's art-free prototype profile -- which is what made the demo's
// portal read as a thin green sliver next to the game's -- the sample ships
// the same two textures and the same parameter values. The shader programs
// themselves are engine-owned (engine/assets/programs/{psx,vfx}.program), so
// only the profiles are duplicated here.
//
// Keep in step with the game's copies: the point of the station is that the
// demo portal and the in-game portal are the same object.

// The kit is authored with V pointing the other way; the flip lives in the
// material rather than in 44 re-exported meshes.
material Kit/Dungeon
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit
        {
            param_named uvScale float2 1.0 -1.0
            param_named uvOffset float2 0.0 1.0
        }
        fragment_program_ref PSX_FS_Dungeon { }
        texture_unit
        {
            texture Dungeon_Map.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

// Descent portal membrane: opaque emissive with a continuously scrolling flow
// map. Values above 1 intentionally feed the bloom pass.
material Game/PortalDown
{
    technique { pass {
        cull_hardware none
        depth_write on
        vertex_program_ref PixelVfx/PortalVS { }
        fragment_program_ref PixelVfx/PortalFS
        {
            param_named portalDark float4 0.025 0.075 0.015 1.0
            param_named portalMid float4 0.12 0.92 0.055 1.0
            param_named portalBright float4 0.80 1.65 0.18 1.0
            param_named portalFlowSpeed float 0.28
        }
        texture_unit
        {
            texture slime_stylized.png
            filtering none
            tex_address_mode wrap
        }
    } }
}
