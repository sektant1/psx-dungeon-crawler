// Shared stylized-fantasy material library. Names describe visual intent, not
// a single mesh, so generated primitives and imported assets can reuse them.

material Fantasy/CarvedStone
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { param_named uvScale float2 2.0 2.0 }
        fragment_program_ref PSX_FS_Lit
        { param_named modulateColor float4 0.72 0.68 0.78 1.0 }
        texture_unit {
            texture tiny_cobble_01.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/WarmDungeonStone
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { param_named uvScale float2 2.5 2.5 }
        fragment_program_ref PSX_FS_Lit
        { param_named modulateColor float4 0.82 0.63 0.46 1.0 }
        texture_unit {
            texture tiny_brick_02.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/DarkIron
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_LitMetal
        { param_named modulateColor float4 0.28 0.31 0.40 1.0 }
        texture_unit {
            texture metal-tex.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/AgedWood
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { param_named uvScale float2 1.5 1.5 }
        fragment_program_ref PSX_FS_Lit
        { param_named modulateColor float4 0.72 0.45 0.25 1.0 }
        texture_unit {
            texture tiny_wood_03.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/FelEnergy
{
    technique { pass {
        cull_hardware none
        depth_write on
        vertex_program_ref Sprite/VS {
            param_named spriteUvScale float2 1.35 1.35
            param_named spriteScroll float2 0.28 -0.20
        }
        fragment_program_ref Sprite/FS
        { param_named spriteTint float4 0.34 0.58 0.16 1.0 }
        texture_unit {
            texture slime_stylized.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/Lava
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/LiquidFS {
            param_named liquidDark float4 0.22 0.015 0.005 1.0
            param_named liquidMid float4 1.10 0.16 0.015 1.0
            param_named liquidBright float4 1.55 0.82 0.08 1.0
            param_named liquidFlowA float2 0.045 -0.025
            param_named liquidFlowB float2 -0.020 0.032
            param_named liquidEmission float 0.55
        }
        texture_unit {
            texture lava_stylized.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/Water
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/LiquidFS {
            param_named liquidDark float4 0.015 0.07 0.20 1.0
            param_named liquidMid float4 0.03 0.42 0.92 1.0
            param_named liquidBright float4 0.22 0.92 1.20 1.0
            param_named liquidFlowA float2 0.07 0.035
            param_named liquidFlowB float2 -0.035 0.055
            param_named liquidEmission float 0.0
        }
        texture_unit {
            texture water_stylized.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/ToxicSlime
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/LiquidFS {
            param_named liquidDark float4 0.025 0.14 0.015 1.0
            param_named liquidMid float4 0.12 0.95 0.025 1.0
            param_named liquidBright float4 0.78 1.38 0.08 1.0
            param_named liquidFlowA float2 -0.035 0.055
            param_named liquidFlowB float2 0.045 -0.020
            param_named liquidEmission float 0.20
        }
        texture_unit {
            texture slime_stylized.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Fantasy/ArcaneGlow
{
    technique { pass {
        scene_blend add
        // Closed glow geometry must depth-test itself; otherwise overlapping
        // front and back faces add together into a blown-out slab.
        depth_write on
        vertex_program_ref Sprite/VS { param_named spriteScroll float2 0.03 -0.04 }
        fragment_program_ref Sprite/FS
        { param_named spriteTint float4 0.35 0.42 1.0 0.80 }
        texture_unit {
            texture glow_radial.png
            filtering none
            tex_address_mode clamp
        }
    } }
}
