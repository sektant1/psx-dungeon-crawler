// Placeholder enemy materials.
//
// Enemies are untextured cylinders for now, tinted through modulateColor over a
// flat white texture. The tint is the whole read: value separates tiers (a
// brute is darker and heavier than a grunt), and saturation separates threat
// (bosses are the only fully saturated red in the palette).
//
// These are lit with the same PSX_*_Lit programs as world geometry on purpose:
// a placeholder that ignores the dungeon's torchlight looks like a bug, and an
// enemy you cannot lose in a dark corridor is not being playtested honestly.
//
// Swapping in authored art means changing `visual.material` in enemies.toml.
// Nothing in C++ names these.

material Game/EnemyRed
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.78 0.14 0.12 1.0
        }
        texture_unit
        {
            texture white.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

// Heavies: darker, closer to dried blood. Reads as "this one hits harder".
material Game/EnemyRedDark
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.42 0.07 0.07 1.0
        }
        texture_unit
        {
            texture white.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

// Skirmishers/casters: lighter and pinker, so a fast one is distinguishable at
// silhouette distance in a corridor.
material Game/EnemyRedPale
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.92 0.42 0.38 1.0
        }
        texture_unit
        {
            texture white.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

// Bosses and elites: full-chroma, the only one in the palette that is.
material Game/EnemyRedElite
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 1.0 0.10 0.06 1.0
        }
        texture_unit
        {
            texture white.png
            filtering none
            tex_address_mode clamp
        }
    } }
}
