// Art-free counterparts to the PixelVfx programs in vfx.program.
//
// Same uniform names and same defaults as the authored versions, minus the
// texture sampler: a scene that has lost its VFX textures still gets the effect
// instead of a flat prototype box. The extra *NoiseScale knob sets the feature
// size of the procedural field that replaces the texture lookup.
//
// The vertex stage is shared with the authored shaders -- portal.vert and
// liquid.vert only forward UVs, so there is nothing texture-bound to replace.

fragment_program PixelVfx/PrototypePortalFS glsl
{
    source prototype_portal.frag
    default_params {
        param_named portalDark float4 0.03 0.08 0.02 1.0
        param_named portalMid float4 0.18 0.72 0.08 1.0
        param_named portalBright float4 0.70 1.45 0.22 1.0
        param_named portalStepFps float 10.0
        param_named portalFlowSpeed float 0.24
        param_named portalPixelGrid float 48.0
        param_named portalNoiseScale float 4.0
        param_named_auto time time 1.0
    }
}

fragment_program PixelVfx/PrototypeLiquidFS glsl
{
    source prototype_liquid.frag
    default_params {
        param_named liquidDark float4 0.02 0.08 0.16 1.0
        param_named liquidMid float4 0.05 0.42 0.78 1.0
        param_named liquidBright float4 0.28 0.90 1.0 1.0
        param_named liquidFlowA float2 0.07 0.035
        param_named liquidFlowB float2 -0.035 0.055
        param_named liquidStepFps float 8.0
        param_named liquidPixelGrid float 32.0
        param_named liquidEmission float 0.0
        param_named liquidNoiseScale float 3.0
        param_named_auto time time 1.0
    }
}
