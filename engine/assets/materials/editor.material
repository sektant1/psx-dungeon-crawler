// Editor-only materials: the staging floor and backdrop of the material
// preview scene. Nothing in the game references these, so they cannot move the
// rendered image of the game itself -- the visual freeze holds.

// Infinite procedural checkerboard, generated from world position. Scale is in
// metres per square, so the pattern reads as a real-world reference grid: half
// a metre is small enough to judge tiling against, large enough not to buzz.
material Editor/Checkerboard
{
    technique { pass {
        vertex_program_ref Editor_VS_Checkerboard { }
        fragment_program_ref Editor_FS_Checkerboard
        {
            param_named checkerColourA float4 0.52 0.53 0.55 1.0
            param_named checkerColourB float4 0.30 0.31 0.33 1.0
            param_named checkerScale float 0.5
        }
    } }
}

// Same floor, tuned darker for judging bright or emissive materials that blow
// out against the default grey.
material Editor/CheckerboardDark
{
    technique { pass {
        vertex_program_ref Editor_VS_Checkerboard { }
        fragment_program_ref Editor_FS_Checkerboard
        {
            param_named checkerColourA float4 0.16 0.165 0.18 1.0
            param_named checkerColourB float4 0.09 0.095 0.11 1.0
            param_named checkerScale float 0.5
        }
    } }
}
