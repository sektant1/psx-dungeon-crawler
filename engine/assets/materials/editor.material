// Editor-only materials: the staging floor and backdrop of the material
// preview scene. Nothing in the game references these, so they cannot move the
// rendered image of the game itself -- the visual freeze holds.

// Infinite procedural checkerboard, generated from world position. Scale is in
// metres per square, so the pattern reads as a real-world reference grid: half
// a metre is small enough to judge tiling against, large enough not to buzz.
material Editor/Checkerboard
{
    technique { pass {
        vertex_program_ref Editor_VS_Checkerboard { }
        fragment_program_ref Editor_FS_Checkerboard
        {
            param_named checkerColourA float4 0.52 0.53 0.55 1.0
            param_named checkerColourB float4 0.30 0.31 0.33 1.0
            param_named checkerScale float 0.5
        }
    } }
}

// Same floor, tuned darker for judging bright or emissive materials that blow
// out against the default grey.
material Editor/CheckerboardDark
{
    technique { pass {
        vertex_program_ref Editor_VS_Checkerboard { }
        fragment_program_ref Editor_FS_Checkerboard
        {
            param_named checkerColourA float4 0.16 0.165 0.18 1.0
            param_named checkerColourB float4 0.09 0.095 0.11 1.0
            param_named checkerScale float 0.5
        }
    } }
}

// Demonstration subject for the material stage's quad preview mode: a
// procedural animated fire icon. It exists so the quad rig is visibly testable
// without waiting on any particle work -- select Editor/FireIcon in the editor's
// material list and it should stage as a flat animated square, not a sphere
// (see engine/assets/material_preview.toml).
//
// The programs are declared inline rather than in a .program file because they
// are used by exactly this one editor-only material and by nothing else.
//
// Time reaches the shader through Ogre's built-in `time` auto param, the same
// mechanism engine/assets/programs/vfx.program already uses for the portal,
// liquid and lava shaders. No per-frame C++ push is involved.
vertex_program Editor_VS_Icon glsl
{
    source quad.vert
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}

fragment_program Editor_FS_FireIcon glsl
{
    source fire_icon.frag
    default_params
    {
        param_named fireDark float4 0.30 0.035 0.010 1.0
        param_named fireMid float4 0.95 0.16 0.02 1.0
        param_named fireHot float4 1.60 0.55 0.05 1.0
        param_named fireCore float4 2.10 1.45 0.35 1.0
        param_named firePixelGrid float 48.0
        param_named fireStepFps float 10.0
        param_named fireRiseSpeed float 0.35
        param_named_auto time time 1.0
    }
}

material Editor/FireIcon
{
    technique { pass {
        // Unlit, two-sided, depth-tested but not depth-writing: it is a sprite,
        // and the shader discards everything outside the flame silhouette.
        lighting off
        cull_hardware none
        depth_write off
        vertex_program_ref Editor_VS_Icon { }
        fragment_program_ref Editor_FS_FireIcon { }
    } }
}

// Brush placement preview. Hidden from material pickers by the internal `__`
// prefix; this exists only for transient editor geometry under the cursor.
fragment_program Editor_FS_PlacementGhost glsl
{
    source placement_ghost.frag
    default_params
    {
        param_named ghostColour float4 0.20 1.00 0.52 0.34
        param_named_auto farClip far_clip_distance
    }
}

material Editor/PlacementGhost
{
    technique { pass {
        lighting off
        cull_hardware none
        scene_blend alpha_blend
        depth_write off
        vertex_program_ref Editor_VS_Checkerboard { }
        fragment_program_ref Editor_FS_PlacementGhost { }
    } }
}
