// Engine-owned prototype VFX materials.
//
// These are fallback targets, not dressing: they use the procedural
// PixelVfx/Prototype* programs, so they render correctly in a tree that ships
// no VFX textures at all. Renderer routes a missing portal/liquid/lava material
// here by name (see prototype::fallbackMaterialFor), which is why a missing
// Game/Vfx/PortalUp still reads as a portal rather than a checkered box.
//
// Each is one profile of a shared shader -- palette plus flow. Add a profile by
// copying a block and changing the params; no new shader required.

// Fel-green descent portal. Matches Game/Vfx/PortalDown's profile.
material Engine/PrototypeVfx/Portal
{
    technique { pass {
        cull_hardware none
        depth_write on
        vertex_program_ref PixelVfx/SurfaceVS { }
        fragment_program_ref PixelVfx/PrototypePortalFS
        {
            param_named surfaceDark float4 0.06 0.30 0.05 1.0
            param_named surfaceMid float4 0.16 1.05 0.07 1.0
            param_named surfaceBright float4 0.85 1.80 0.20 1.0
            param_named surfaceCore float4 1.55 2.40 0.70 1.0
            param_named portalFlowSpeed float 0.32
            param_named portalSwirlSpeed float 0.09
            param_named surfaceGlowColour float4 1.30 0.10 2.20 1.0
        }
    } }
}

// Arcane-blue ascent portal: the same flow reversed. Matches Game/Vfx/PortalUp.
material Engine/PrototypeVfx/PortalUp
{
    technique { pass {
        cull_hardware none
        depth_write on
        vertex_program_ref PixelVfx/SurfaceVS { }
        fragment_program_ref PixelVfx/PrototypePortalFS
        {
            param_named surfaceDark float4 0.015 0.04 0.15 1.0
            param_named surfaceMid float4 0.08 0.58 1.10 1.0
            param_named surfaceBright float4 0.32 1.15 1.80 1.0
            param_named surfaceCore float4 1.05 1.85 2.60 1.0
            param_named portalFlowSpeed float -0.26
            param_named portalSwirlSpeed float -0.07
            param_named surfaceGlowColour float4 0.45 1.55 2.40 1.0
        }
    } }
}

// Water. Matches Game/Vfx/Water's profile.
material Engine/PrototypeVfx/Liquid
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/PrototypeLiquidFS
        {
            param_named liquidDark float4 0.015 0.07 0.20 1.0
            param_named liquidMid float4 0.03 0.42 0.92 1.0
            param_named liquidBright float4 0.22 0.92 1.20 1.0
            param_named liquidFlowA float2 0.07 0.035
            param_named liquidFlowB float2 -0.035 0.055
            param_named liquidEmission float 0.0
        }
    } }
}

// Lava: the liquid shader driven hot, with emission feeding the bloom pass.
// Values above 1 are intentional. Matches Game/Vfx/Lava's profile.
material Engine/PrototypeVfx/Lava
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/PrototypeLiquidFS
        {
            param_named liquidDark float4 0.10 0.003 0.001 1.0
            param_named liquidMid float4 0.42 0.018 0.003 1.0
            param_named liquidBright float4 1.70 0.30 0.012 1.0
            param_named liquidFlowA float2 0.03 0.018
            param_named liquidFlowB float2 -0.016 0.026
            param_named liquidStepFps float 10.0
            param_named liquidPixelGrid float 40.0
            param_named liquidEmission float 0.35
        }
    } }
}

// Toxic slime. Matches Game/Vfx/ToxicSlime's profile.
material Engine/PrototypeVfx/Slime
{
    technique { pass {
        depth_write on
        vertex_program_ref PixelVfx/LiquidVS { }
        fragment_program_ref PixelVfx/PrototypeLiquidFS
        {
            param_named liquidDark float4 0.025 0.14 0.015 1.0
            param_named liquidMid float4 0.12 0.95 0.025 1.0
            param_named liquidBright float4 0.78 1.38 0.08 1.0
            param_named liquidFlowA float2 -0.035 0.055
            param_named liquidFlowB float2 0.045 -0.020
            param_named liquidEmission float 0.20
        }
    } }
}
