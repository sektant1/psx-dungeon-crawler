Fix OGRE 14.4.1 configure failure under CMake 3.16+ / CMake 16.

MACRO_LOG_FEATURE uses `IF (${_minvers} MATCHES ".*")` with unquoted variables.
When the variable is empty or expands to multiple words, newer CMake parses the
unquoted expansion as extra IF arguments and aborts ("Unknown arguments
specified", MacroLogFeature.cmake:85). Quote the operands so the MATCHES test
sees a single string, matching CMake's current argument rules.

--- a/CMake/Utils/MacroLogFeature.cmake
+++ b/CMake/Utils/MacroLogFeature.cmake
@@ -78,13 +78,13 @@ MACRO(MACRO_LOG_FEATURE _var _package _description _url ) # _required _minvers _
    SET(_logtext "+ ${_package}")
 
    IF (NOT ${_var})
-      IF (${_minvers} MATCHES ".*")
+      IF ("${_minvers}" MATCHES ".*")
         SET(_logtext "${_logtext}, ${_minvers}")
-      ENDIF (${_minvers} MATCHES ".*")
+      ENDIF ()
       SET(_logtext "${_logtext}: ${_description} <${_url}>")
-      IF (${_comments} MATCHES ".*")
+      IF ("${_comments}" MATCHES ".*")
         SET(_logtext "${_logtext}\n${_comments}")
-      ENDIF (${_comments} MATCHES ".*")
+      ENDIF ()
 #      SET(_logtext "${_logtext}\n") #double-space missing features?
    ENDIF (NOT ${_var})
    FILE(APPEND "${_LOGFILENAME}" "${_logtext}\n")
