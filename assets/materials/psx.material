            param_named atlasGrid float2 4.0 4.0
            param_named atlasRow float 2.0
            param_named atlasFrames float 4.0
            param_named atlasFps float 7.0
        }
        fragment_program_ref AtlasParticle_FS { }
        texture_unit
        {
            texture retro_particle_atlas.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

material Engine/Psx/LavaAsh
{
    technique { pass {
        cull_hardware none
        scene_blend src_alpha one
        depth_write off
        vertex_program_ref Particle_VS {
            param_named atlasGrid float2 4.0 4.0
            param_named atlasRow float 3.0
            param_named atlasFrames float 4.0
            param_named atlasFps float 8.0
        }
        fragment_program_ref AtlasParticle_FS { }
        texture_unit
        {
            texture retro_particle_atlas.png
            filtering none
