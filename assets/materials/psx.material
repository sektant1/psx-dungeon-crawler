// ------------------------------------------------------------------------
// Generic wrapper materials, one per Godot .gdshader wrapper. The scene
// materials below (Godot .tres ports) use the same program combos with the
// .tres uniform values baked in.
//
// Godot render_mode -> Ogre pass state:
//   cull_back            -> cull_hardware clockwise (default)
//   cull_disabled        -> cull_hardware none
//   depth_draw_opaque    -> depth_write on (opaque) / off (with blending)
//   depth_draw_always    -> depth_write on even when blended
//   depth_prepass_alpha  -> alpha discard in shader + depth_write on
//   blend_mix            -> scene_blend alpha_blend (when transparent)
//   blend_add            -> scene_blend src_alpha one
//   shadows_disabled     -> no Ogre shadow technique enabled anywhere
// ------------------------------------------------------------------------

material Engine/Psx/Lit    // psx_lit.gdshader
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/Unlit    // psx_unlit.gdshader
{
    technique { pass {
        vertex_program_ref PSX_VS_Unlit { }
        fragment_program_ref PSX_FS_Unlit { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/LitMetal    // psx_lit_metal.gdshader
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_LitMetal { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/UnlitMetal    // psx_unlit_metal.gdshader
{
    technique { pass {
        vertex_program_ref PSX_VS_Unlit { }
        fragment_program_ref PSX_FS_UnlitMetal { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/LitTransparent    // psx_lit_transparent.gdshader
{
    technique { pass {
        scene_blend alpha_blend
        depth_write on            // depth_draw_always
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_LitTransparent { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/UnlitTransparent    // psx_unlit_transparent.gdshader
{
    technique { pass {
        scene_blend alpha_blend
        depth_write on
        vertex_program_ref PSX_VS_Unlit { }
        fragment_program_ref PSX_FS_UnlitTransparent { }
        texture_unit
        {
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Engine/Psx/PrototypeSurface
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            texture EnginePrototypeSurface.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

// Engine-owned particle fallback. Its generated orange/cyan diagnostic sprite
// is deliberately distinct from missing surface and sprite textures.
material Engine/Psx/PrototypeParticle
{
    technique { pass {
        cull_hardware none
        scene_blend alpha_blend
        depth_write off
        vertex_program_ref Particle_VS { }
        fragment_program_ref BlockParticle_FS
        {
            param_named alphaScissor float 0.05
        }
        texture_unit
        {
            texture EnginePrototypeParticle.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

// Reusable retro VFX atlas rows: fire, smoke, poison, lava ash.
material Engine/Psx/Fire
{
    technique { pass {
        cull_hardware none
        scene_blend src_alpha one
        depth_write off
        vertex_program_ref Particle_VS {
            param_named atlasGrid float2 4.0 4.0
            param_named atlasRow float 0.0
            param_named atlasFrames float 4.0
            param_named atlasFps float 10.0
        }
        fragment_program_ref AtlasParticle_FS { }
        texture_unit
        {
            texture retro_particle_atlas.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

material Engine/Psx/Smoke
{
    technique { pass {
        cull_hardware none
        scene_blend alpha_blend
        depth_write off
        vertex_program_ref Particle_VS {
            param_named atlasGrid float2 4.0 4.0
            param_named atlasRow float 1.0
            param_named atlasFrames float 4.0
            param_named atlasFps float 6.0
        }
        fragment_program_ref AtlasParticle_FS { }
        texture_unit
        {
            texture retro_particle_atlas.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

material Engine/Psx/Poison
