[material."Game/PropMarketMisc"]
shader = "lit"
texture = "market_misc.png"
filter = "nearest"
address = "repeat"

# --- sprite viewmodel -------------------------------------------------------
# The layered first-person sprite presentation (docs/fps-viewmodel.md).
#
# `depth_test = false` is load-bearing, not laziness. The viewmodel pass runs
# after the world and reuses its depth buffer, so a depth-testing sprite is
# occluded by the wall the player is standing against -- the exact failure a
# first-person presentation element must not have. Ordering within the stack
# comes from SpriteViewmodel sorting its layers farthest-first instead.
#
# One material per ANIMATED layer, because frame selection writes uvScale and
# uvOffset on the material: two layers sharing one would fight over the cell.
#
# Textures are generated by tools/gen_viewmodel_sprites.py -- regenerate rather
# than hand-editing them.

[material."Game/Viewmodel/Sprite/Hands"]
shader = "unlit"
texture = "vm_hands_default.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_test = false
depth_write = false

[material."Game/Viewmodel/Sprite/Talon"]
shader = "unlit"
texture = "vm_weapon_talon.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_test = false
depth_write = false

[material."Game/Viewmodel/Sprite/MuzzleArcane"]
shader = "unlit"
texture = "vm_muzzle_arcane.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "additive"
depth_test = false
depth_write = false
