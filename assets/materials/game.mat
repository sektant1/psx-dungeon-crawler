[material."Game/PropHay"]
shader = "lit"
texture = "hay.png"
filter = "nearest"
address = "repeat"

[material."Game/PropBauerhausTwoSided"]
shader = "lit"
texture = "bauerhaus.png"
filter = "nearest"
address = "repeat"
cull = "none"

[material."Game/PropPlanksTwoSided"]
shader = "lit"
texture = "wood_planks.png"
filter = "nearest"
address = "repeat"
cull = "none"

[material."Game/PropChest"]
shader = "lit"
texture = "chest_albedo.png"
filter = "nearest"
address = "repeat"

[material."Game/Singularity"]
shader = "unlit"
texture = "white.png"
filter = "nearest"
