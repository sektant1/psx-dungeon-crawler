# Engine material definitions. Generated once from the Ogre script
# this file replaced (game.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/Room"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Game/Room".params]
uvScale = [6.0, 6.0]

[material."Game/PropPlanks"]
shader = "lit"
texture = "wood_planks.png"
filter = "nearest"
address = "repeat"

[material."Game/PropVertexColour"]
shader = "lit"
texture = "white.png"
filter = "nearest"

# --- actors -----------------------------------------------------------------
# The humanoid rig every actor wears. Vertex colour is baked into the mesh (see
# tools/author_humanoid_rig.py), so white here draws the mannequin's own grey
# and the tinted Game/Enemy/* materials multiply over the same geometry -- which
# is why an enemy needs a colour, not a mesh, to look like itself.
[material."Game/Actor/Default"]
shader = "lit"
texture = "white.png"
filter = "nearest"

# The player's own body, seen in third person and in a mirror-less world only
# from behind: a touch warmer than the neutral grey so the player reads as the
# one thing in the room that is not a threat.
[material."Game/Actor/Player"]
shader = "lit"
texture = "white.png"
filter = "nearest"

[material."Game/Actor/Player".params]
modulateColor = [0.86, 0.82, 0.74, 1.0]

# Townsfolk. Cooler and lighter than the enemy palette, so a silhouette across
# the threshold reads as safe before its name resolves.
[material."Game/Actor/Npc"]
shader = "lit"
texture = "white.png"
filter = "nearest"

[material."Game/Actor/Npc".params]
modulateColor = [0.72, 0.76, 0.88, 1.0]

[material."Game/PropBauerhaus"]
shader = "lit"
texture = "bauerhaus.png"
filter = "nearest"
address = "repeat"

[material."Game/DungeonTile"]
shader = "lit"
texture = "Dungeon_Map.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonFloor"]
shader = "lit"
texture = "TEX_Ground_04.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonFloor".params]
uvScale = [11.0, 11.0]
uvOffset = [-9.0, -3.0]

[material."Game/DungeonCeiling"]
shader = "lit"
texture = "TEX_Wall_03.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonCeiling".params]
uvScale = [11.0, 11.0]
uvOffset = [-10.0, -3.0]

[material."Game/DungeonWall"]
shader = "lit"
texture = "TEX_Wall_03.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonWall".params]
uvScale = [3.0, 3.0]
uvOffset = [0.0, 0.0]

[material."Game/DungeonTileTwoSided"]
shader = "lit"
texture = "Dungeon_Map.png"
filter = "nearest"
address = "repeat"
cull = "none"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/PropWood"]
shader = "lit"
texture = "generic_wood.png"
filter = "nearest"
address = "repeat"

[material."Game/PropMarket"]
shader = "lit"
texture = "market.png"
filter = "nearest"
address = "repeat"

[material."Game/PropJute"]
shader = "lit"
texture = "jute.png"
filter = "nearest"
address = "repeat"

[material."Game/PropTerracotta"]
shader = "lit"
