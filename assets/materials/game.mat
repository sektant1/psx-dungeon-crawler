# Engine material definitions. Generated once from the Ogre script
# this file replaced (game.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/Room"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Game/Room".params]
uvScale = [6.0, 6.0]

[material."Game/PropPlanks"]
shader = "lit"
texture = "wood_planks.png"
filter = "nearest"
address = "repeat"

[material."Game/PropVertexColour"]
shader = "lit"
texture = "white.png"
filter = "nearest"

[material."Game/PropBauerhaus"]
shader = "lit"
texture = "bauerhaus.png"
filter = "nearest"
address = "repeat"

[material."Game/DungeonTile"]
shader = "lit"
texture = "Dungeon_Map.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonFloor"]
shader = "lit"
texture = "TEX_Ground_04.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonFloor".params]
uvScale = [11.0, 11.0]
uvOffset = [-9.0, -3.0]

[material."Game/DungeonCeiling"]
shader = "lit"
texture = "TEX_Wall_03.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonCeiling".params]
uvScale = [11.0, 11.0]
uvOffset = [-10.0, -3.0]

[material."Game/DungeonWall"]
shader = "lit"
texture = "TEX_Wall_03.png"
filter = "nearest"
address = "repeat"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/DungeonWall".params]
uvScale = [3.0, 3.0]
uvOffset = [0.0, 0.0]

[material."Game/DungeonTileTwoSided"]
shader = "lit"
texture = "Dungeon_Map.png"
filter = "nearest"
address = "repeat"
cull = "none"
# Stone: keeps outlines and creases, refuses the stylize highlight wash.
highlight = false

[material."Game/PropWood"]
shader = "lit"
texture = "generic_wood.png"
filter = "nearest"
address = "repeat"

[material."Game/PropMarket"]
shader = "lit"
texture = "market.png"
filter = "nearest"
address = "repeat"

[material."Game/PropJute"]
shader = "lit"
texture = "jute.png"
filter = "nearest"
address = "repeat"

[material."Game/PropTerracotta"]
shader = "lit"
texture = "terracotta.png"
filter = "nearest"
address = "repeat"

[material."Game/PropLamp"]
shader = "lit"
texture = "lamp_texture.png"
filter = "nearest"
address = "repeat"

[material."Game/PropWeapon"]
shader = "lit"
texture = "MedievalWeaponsSword.png"
filter = "nearest"
address = "repeat"

[material."Game/ViewModelWeapon"]
shader = "lit"
texture = "MedievalWeaponsSword.png"
filter = "nearest"
address = "repeat"
depth_test = true
depth_write = true

[material."Game/FirstPersonHands"]
shader = "lit"
texture = "arms_01.png"
filter = "nearest"
address = "clamp"
cull = "none"
depth_test = true
depth_write = true

[material."Game/ViewModelVesper"]
shader = "lit"
texture = "proto_dark_09.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelVesperGlow"]
shader = "lit"
texture = "proto_purple_10.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelVesperGlow".params]
modulateColor = [0.75, 0.36, 1.30, 1.0]

[material."Game/ViewModelEidolon"]
shader = "lit"
texture = "proto_dark_05.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelEidolonGlow"]
shader = "lit"
texture = "proto_light_03.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelEidolonGlow".params]
modulateColor = [0.42, 0.95, 1.25, 1.0]

[material."Game/ViewModelTalon"]
shader = "lit"
texture = "proto_dark_12.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelTalonGlow"]
shader = "lit"
texture = "proto_orange_07.png"
filter = "nearest"
depth_test = true
depth_write = true

[material."Game/ViewModelTalonGlow".params]
modulateColor = [1.30, 0.28, 0.08, 1.0]

[material."Game/PropHay"]
shader = "lit"
texture = "hay.png"
filter = "nearest"
address = "repeat"

[material."Game/PropBauerhausTwoSided"]
shader = "lit"
texture = "bauerhaus.png"
filter = "nearest"
address = "repeat"
cull = "none"

[material."Game/PropPlanksTwoSided"]
shader = "lit"
texture = "wood_planks.png"
filter = "nearest"
address = "repeat"
cull = "none"

[material."Game/PropChest"]
shader = "lit"
texture = "chest_albedo.png"
filter = "nearest"
address = "repeat"

[material."Game/Singularity"]
shader = "unlit"
texture = "white.png"
filter = "nearest"
address = "repeat"
cull = "none"
depth_write = true

[material."Game/Singularity".params]
modulateColor = [0.55, 0.25, 1.0, 1.0]

[material."Game/PortalStone"]
shader = "lit.untextured"

[material."Game/PortalStone".params]
modulateColor = [0.24, 0.18, 0.29, 1.0]

[material."Game/Torch"]
shader = "lit"
texture = "white.png"
filter = "nearest"
address = "repeat"

[material."Game/FireParticle"]
shader = "particle.flame"
texture = "sparkle.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "additive"
depth_write = false

[material."Game/FireParticle".params]
alphaScissor = 0.1

[material."Game/AshParticle"]
shader = "particle.block"
texture = "sparkle.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_write = false

[material."Game/AshParticle".params]
alphaScissor = 0.1

[material."Game/SmokeParticle"]
shader = "particle.smoke"
texture = "white.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_write = false

[material."Game/SmokeParticle".params]
alphaScissor = 0.025

[material."Game/PropMarketMisc"]
shader = "lit"
texture = "market_misc.png"
filter = "nearest"
address = "repeat"
