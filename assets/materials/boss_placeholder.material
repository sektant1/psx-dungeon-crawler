// Textured source-model placeholder used for boss framing and scale tests.
material Game/BossPlaceholder
{
    technique { pass {
        cull_hardware none
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            texture boss_placeholder_base_color.png
            filtering none
            tex_address_mode clamp
        }
    } }
}

material Game/BossPlaceholderSword
{
    technique { pass {
        cull_hardware none
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            texture boss_placeholder_sword_base_color.png
            filtering none
            tex_address_mode clamp
        }
    } }
}
