# Engine material definitions. Generated once from the Ogre script
# this file replaced (import_mechademonlord.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/import_mechademonlord/part0"]
shader = "lit"
texture = "import_mechademonlord_387.png"
filter = "nearest"
address = "repeat"

[material."Game/import_mechademonlord/part1"]
shader = "lit"
texture = "import_mechademonlord_386.png"
filter = "nearest"
address = "repeat"
