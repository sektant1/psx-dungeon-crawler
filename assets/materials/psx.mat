# Engine material definitions. Generated once from the Ogre script
# this file replaced (psx.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Engine/Psx/Lit"]
shader = "lit"
filter = "nearest"
address = "repeat"

[material."Engine/Psx/Unlit"]
shader = "unlit"
filter = "nearest"
address = "repeat"

[material."Engine/Psx/LitMetal"]
shader = "lit.metal"
filter = "nearest"
address = "repeat"

[material."Engine/Psx/UnlitMetal"]
shader = "unlit.metal"
filter = "nearest"
address = "repeat"

[material."Engine/Psx/LitTransparent"]
shader = "lit"
filter = "nearest"
address = "repeat"
blend = "alpha"
depth_write = true

[material."Engine/Psx/UnlitTransparent"]
shader = "unlit"
filter = "nearest"
address = "repeat"
blend = "alpha"
depth_write = true

[material."Engine/Psx/PrototypeSurface"]
shader = "lit"
texture = "EnginePrototypeSurface.png"
filter = "nearest"
address = "repeat"

[material."Engine/Psx/PrototypeParticle"]
shader = "particle.block"
texture = "EnginePrototypeParticle.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_write = false

[material."Engine/Psx/PrototypeParticle".params]
alphaScissor = 0.05

[material."Engine/Psx/Fire"]
shader = "particle.atlas"
texture = "retro_particle_atlas.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/Fire".params]
atlasGrid = [4.0, 4.0]
atlasRow = 0.0
atlasFrames = 4.0
atlasFps = 10.0

[material."Engine/Psx/Smoke"]
shader = "particle.atlas"
texture = "retro_particle_atlas.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_write = false

[material."Engine/Psx/Smoke".params]
atlasGrid = [4.0, 4.0]
atlasRow = 1.0
atlasFrames = 4.0
atlasFps = 6.0

[material."Engine/Psx/Poison"]
shader = "particle.atlas"
texture = "retro_particle_atlas.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/Poison".params]
atlasGrid = [4.0, 4.0]
atlasRow = 2.0
atlasFrames = 4.0
atlasFps = 7.0

[material."Engine/Psx/LavaAsh"]
shader = "particle.atlas"
texture = "retro_particle_atlas.png"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/LavaAsh".params]
atlasGrid = [4.0, 4.0]
atlasRow = 3.0
atlasFrames = 4.0
atlasFps = 8.0

[material."Engine/Psx/Rain"]
shader = "particle.rain"
cull = "none"
blend = "alpha"
depth_write = false

[material."Engine/Psx/ArcaneMote"]
shader = "particle.mote"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/FrostShard"]
shader = "particle.shard"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/ToxicBubble"]
shader = "particle.bubble"
cull = "none"
blend = "alpha"
depth_write = false

[material."Engine/Psx/PortalWisp"]
shader = "particle.wisp"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/LitAlphaScissor"]
shader = "lit"
filter = "nearest"
address = "repeat"
cull = "none"
blend = "alpha"
depth_write = true

[material."Engine/Psx/UnlitAlphaScissor"]
shader = "unlit"
filter = "nearest"
address = "repeat"
cull = "none"
blend = "alpha"
depth_write = true

[material."Engine/Psx/LightVolume"]
shader = "unlit.light_volume"
cull = "none"
blend = "additive"
depth_write = false

[material."Engine/Psx/DebugLines"]
shader = "debug_lines"
cull = "none"

[material."Engine/Psx/DebugWireframe"]
shader = "wire"
cull = "none"
polygon = "line"

[material."Engine/Psx/DitherPost"]
shader = "post.grade"
texture = "psxdither.png"
filter = "nearest"
address = "repeat"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/HardwareResolve"]
shader = "post.resolve"
filter = "nearest"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/PixelStylize"]
shader = "post.stylize"
filter = "nearest"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/BloomBright"]
shader = "post.bloom_bright"
filter = "linear"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/BloomBlurH"]
shader = "post.bloom_blur"
filter = "linear"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/BloomBlurH".params]
blurDir = [1.0, 0.0]

[material."Engine/Psx/BloomBlurV"]
shader = "post.bloom_blur"
filter = "linear"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/BloomBlurV".params]
blurDir = [0.0, 1.0]

[material."Engine/Psx/BloomComposite"]
shader = "post.bloom_composite"
filter = "linear"
address = "clamp"
cull = "none"
depth_test = false
depth_write = false

[material."Engine/Psx/PreviewSprite"]
shader = "sprite"
filter = "nearest"
address = "clamp"
cull = "none"
blend = "alpha"
depth_write = false
