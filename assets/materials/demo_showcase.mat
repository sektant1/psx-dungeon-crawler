# Engine material definitions. Generated once from the Ogre script
# this file replaced (demo_showcase.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Demo/Showcase/CrystalSpirePink"]
shader = "lit.untextured"

[material."Demo/Showcase/CrystalSpirePink".params]
modulateColor = [1.0, 0.34, 0.72, 1.0]
rimColour = [1.0, 0.55, 0.95, 0.95]
rimPower = 2.2

[material."Demo/Showcase/CrystalGroundPink"]
shader = "lit.untextured"

[material."Demo/Showcase/CrystalGroundPink".params]
modulateColor = [0.72, 0.26, 0.55, 1.0]
rimColour = [0.95, 0.45, 0.85, 0.55]
rimPower = 3.2

[material."Demo/Showcase/Stone"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Demo/Showcase/Stone".params]
uvScale = [3.0, 3.0]
modulateColor = [0.46, 0.49, 0.58, 1.0]

[material."Demo/Showcase/PortalBacking"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Demo/Showcase/PortalBacking".params]
uvScale = [2.0, 2.0]
modulateColor = [0.24, 0.25, 0.30, 1.0]
