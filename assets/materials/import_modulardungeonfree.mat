# Engine material definitions. Generated once from the Ogre script
# this file replaced (import_modulardungeonfree.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/import_modulardungeonfree/part0"]
shader = "lit"
texture = "import_modulardungeonfree_image0.png"
filter = "nearest"
address = "repeat"
cull = "none"

[material."Game/import_modulardungeonfree/part1"]
shader = "lit"
texture = "import_modulardungeonfree_image1.png"
filter = "nearest"
address = "repeat"
cull = "none"

