// Prototype materials for editor floors, blank scenes and physics projectiles.

material Game/Prototype/Floor
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit
        {
            param_named uvScale float2 16.0 16.0
        }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.72 0.78 0.76 1.0
        }
        texture_unit
        {
            texture proto_light_06.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

// Arrow: dark earth tones; Bolt: bright arcane white.

material Game/Prototype/Arrow
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            texture proto_dark_05.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

material Game/Prototype/Bolt
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit { }
        texture_unit
        {
            texture proto_light_03.png
            filtering none
            tex_address_mode wrap
        }
    } }
}

// Player projectile silhouettes. Shape remains primary identifier; colour
// separates them at peripheral vision without resembling hostile red bolts.
material Game/Prototype/ProjectileVesper
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.72 0.42 1.35 1.0
        }
        texture_unit
        {
            texture proto_purple_10.png
            filtering none
        }
    } }
}

material Game/Prototype/ProjectileEidolon
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 0.55 1.10 1.40 1.0
        }
        texture_unit
        {
            texture proto_light_03.png
            filtering none
        }
    } }
}

material Game/Prototype/ProjectileTalon
{
    technique { pass {
        vertex_program_ref PSX_VS_Lit { }
        fragment_program_ref PSX_FS_Lit
        {
            param_named modulateColor float4 1.40 0.30 0.12 1.0
        }
        texture_unit
        {
            texture proto_orange_07.png
            filtering none
        }
    } }
}
