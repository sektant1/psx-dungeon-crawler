# Engine material definitions. Generated once from the Ogre script
# this file replaced (demo.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/Demo/Floor"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/Floor".params]
uvScale = [24.0, 24.0]
modulateColor = [0.66, 0.7, 0.8, 1.0]

[material."Game/Demo/BoxMetal"]
shader = "lit.metal"
texture = "metal-tex.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/BoxMetal".params]
modulateColor = [0.95, 0.6, 0.0, 1.0]

[material."Game/Demo/BoxLit"]
shader = "lit"
texture = "Prototype_orange_32x32px.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/CrystalSpire"]
shader = "lit.untextured"

[material."Game/Demo/CrystalSpire".params]
rimColour = [0.75, 0.9, 1.0, 0.85]
rimPower = 2.5

[material."Game/Demo/CrystalGround"]
shader = "lit.untextured"

[material."Game/Demo/CrystalGround".params]
rimColour = [0.75, 0.9, 1.0, 0.4]
rimPower = 3.0

[material."Game/Demo/Sparkle"]
shader = "unlit"
texture = "sparkle.png"
filter = "nearest"
address = "repeat"
cull = "none"
blend = "alpha"
depth_write = true

[material."Game/Demo/Sparkle".params]
alphaScissor = 0.1

[material."Game/Demo/LightShaft"]
shader = "unlit.light_volume"
cull = "none"
blend = "additive"
depth_write = false

# What the turntable showroom puts on a bare mesh that has no material of its
# own -- drop an .obj in assets/ and `make demo MODEL=<path>` and this is what
# it wears. Mid-grey rather than white on purpose: the showroom's key light is
# strong enough that a white albedo clips flat and the model becomes its own
# silhouette, which is exactly what an inspection shot must not do. Two-sided,
# because a mesh being looked at for the first time is often one that has some
# of its winding backwards.
[material."Game/Demo/TurntableNeutral"]
shader = "lit"
texture = "white.png"
filter = "nearest"
cull = "none"

[material."Game/Demo/TurntableNeutral".params]
modulateColor = [0.46, 0.45, 0.48, 1.0]
