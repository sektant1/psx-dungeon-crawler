# Engine material definitions. Generated once from the Ogre script
# this file replaced (demo.material); hand-edited since.
#
# `shader` names the engine shader family outright. It used to be
# recovered by substring-matching an Ogre program name, which meant a
# rename silently changed how a material drew.

[material."Game/Demo/Floor"]
shader = "lit"
texture = "floor.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/Floor".params]
uvScale = [24.0, 24.0]
modulateColor = [0.66, 0.7, 0.8, 1.0]

[material."Game/Demo/BoxMetal"]
shader = "lit.metal"
texture = "metal-tex.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/BoxMetal".params]
modulateColor = [0.95, 0.6, 0.0, 1.0]

[material."Game/Demo/BoxLit"]
shader = "lit"
texture = "Prototype_orange_32x32px.png"
filter = "nearest"
address = "repeat"

[material."Game/Demo/CrystalSpire"]
shader = "lit.untextured"

[material."Game/Demo/CrystalSpire".params]
rimColour = [0.75, 0.9, 1.0, 0.85]
rimPower = 2.5

[material."Game/Demo/CrystalGround"]
shader = "lit.untextured"

[material."Game/Demo/CrystalGround".params]
rimColour = [0.75, 0.9, 1.0, 0.4]
rimPower = 3.0

[material."Game/Demo/Sparkle"]
shader = "unlit"
texture = "sparkle.png"
filter = "nearest"
address = "repeat"
cull = "none"
blend = "alpha"
depth_write = true

[material."Game/Demo/Sparkle".params]
alphaScissor = 0.1

[material."Game/Demo/LightShaft"]
shader = "unlit.light_volume"
cull = "none"
blend = "additive"
depth_write = false
