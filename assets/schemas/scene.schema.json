{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven-engine.invalid/schemas/scene.schema.json",
  "title": "Raven Engine Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "entities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "raven-scene"
    },
    "version": {
      "description": "1 shipped before the placement editor; 2 adds cell, encounters and triggers. Readers accept both, the writer emits 2.",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_degrees": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "half_extents"
      ],
      "properties": {
        "shape": {
          "const": "box"
        },
        "half_extents": {
          "$ref": "#/$defs/vec3"
        },
        "offset": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "cell": {
      "description": "Authored grid placement for kit pieces that occupy a cell or a cell edge. The transform is derived from this; both are stored so re-editing never has to guess a cell back out of a world position.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "col",
        "row"
      ],
      "properties": {
        "col": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        },
        "edge": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "span": {
          "type": "integer",
          "minimum": 1
        },
        "yaw_quarters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "level": {
          "type": "number"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "event"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/vec3"
        },
        "event": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "colour"
      ],
      "properties": {
        "type": {
          "enum": [
            "directional",
            "point"
          ]
        },
        "colour": {
          "$ref": "#/$defs/vec3"
        },
        "range": {
          "type": "number",
          "minimum": 0
        },
        "cast_shadows": {
          "type": "boolean"
        },
        "animation": {
          "description": "How the light modulates over time. The modulation only ever darkens: the authored colour is the brightest the light gets, because that is the value the palette was graded against.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "steady",
                "flicker",
                "pulse"
              ]
            },
            "speed": {
              "type": "number",
              "minimum": 0
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "phase": {
              "description": "Per-instance offset. Two torches with identical numbers and no phase gutter in lockstep, which reads as a switch rather than fire.",
              "type": "number"
            }
          }
        }
      }
    },
    "camera": {
      "description": "A point of view. The entity's transform is where it is and what it looks along; this is the lens. A scene with an active camera plays itself as a shot rather than as a level.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fov_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "near_clip": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "far_clip": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "priority": {
          "description": "The highest-priority active camera in the scene is the one the game looks through.",
          "type": "integer"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "first_person": {
      "description": "The player's body and lens, authored on the camera that is their eye. The game pushes these into the controller it already owns; a scene without one runs on the game's config defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moveSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mouseSensitivity": {
          "description": "Radians of view per pixel of mouse movement.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseFovDegrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "sprintFovKick": {
          "description": "Degrees added at full sprint. Restrained on purpose.",
          "type": "number",
          "minimum": 0
        },
        "bobAmount": {
          "description": "Camera head-bob amplitude in metres. The weapon has its own, louder bob.",
          "type": "number",
          "minimum": 0
        },
        "bobSpeed": {
          "type": "number",
          "minimum": 0
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "viewmodel_preview": {
      "description": "Editor-only: show the first-person hands holding a weapon at this entity, so a placement can be judged in the viewport instead of by launching the game. The cook drops it; no runtime component corresponds to it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weapon": {
          "description": "A player_weapon id from assets/config/weapons.toml. Empty shows slot 0, which is what the player starts the level holding.",
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "viewmodel_rig": {
      "description": "Where the first-person hands sit in front of the eye and how strongly each procedural layer moves them. Every weapon inherits this framing and only leans out of it. Same fields as game.toml's [player_viewmodel]; a scene carrying this overrides that default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "description": "Camera space: +x right, +y up, -z forward.",
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "description": "Degrees: pitch, yaw, roll.",
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bobScale": {
          "type": "number",
          "minimum": 0
        },
        "swayScale": {
          "type": "number",
          "minimum": 0
        },
        "recoilScale": {
          "type": "number",
          "minimum": 0
        },
        "bobReferenceSpeed": {
          "description": "Player speed the walk cycle is normalised against, so retuning move speed does not retune the bob.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bobRollDegrees": {
          "type": "number",
          "minimum": 0
        },
        "swayReturn": {
          "type": "number",
          "minimum": 0
        },
        "swayMax": {
          "description": "Metres. Clamps how far a fast flick can throw the hands.",
          "type": "number",
          "minimum": 0
        },
        "swayRollDegrees": {
          "type": "number",
          "minimum": 0
        },
        "landingDip": {
          "type": "number",
          "minimum": 0
        },
        "landingRecovery": {
          "type": "number",
          "minimum": 0
        },
        "motionEnabled": {
          "description": "False freezes every layer at the socket pose, which is how a placement is authored.",
          "type": "boolean"
        }
      }
    },
    "audio": {
      "description": "A runtime audio clip attached to the entity transform. Source is a logical path under the mounted content pack.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/vec3"
        },
        "bus": {
          "enum": [
            "music",
            "ambience",
            "dialogue",
            "weapons",
            "sfx",
            "ui",
            "warnings"
          ]
        },
        "gain_db": {
          "type": "number",
          "minimum": -80,
          "maximum": 12
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_distance": {
          "type": "number",
          "minimum": 0
        },
        "max_distance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rolloff": {
          "type": "number",
          "minimum": 0
        },
        "doppler_factor": {
          "type": "number",
          "minimum": 0
        },
        "priority": {
          "enum": [
            "background",
            "low",
            "normal",
            "important",
            "critical"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "stream": {
          "type": "boolean"
        },
        "spatial": {
          "type": "boolean"
        },
        "autostart": {
          "type": "boolean"
        },
        "stealable": {
          "type": "boolean"
        }
      }
    },
    "audio_listener": {
      "description": "Candidate listener attached to the entity transform. Highest-priority active listener wins.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "spin": {
      "description": "Constant rotation about a local axis. Whatever is parented under it turns with it, which is how an orbiting camera is authored rather than coded.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "degrees_per_second": {
          "type": "number"
        }
      }
    },
    "mesh": {
      "description": "A mesh file named directly, for geometry that is not part of the modular kit. The path is relative to the asset root, the same form MeshSource carries, so the cooked map stays portable. Mutually exclusive with prefab and primitive.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]"
        },
        "import_scale": {
          "description": "Multiplies the entity's transform scale, for a file authored in units other than metres. A fact about the file, so fixing it once fixes every instance.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "primitive": {
      "description": "A mesh the engine generates from parameters. Every field is optional: an omitted one takes eng::ecs::PrimitiveMesh's default, and the generators read only the fields their kind uses. Mutually exclusive with prefab and mesh.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "box",
            "beveled_box",
            "sphere",
            "capsule",
            "cylinder",
            "cone",
            "plane",
            "disc"
          ]
        },
        "size": {
          "$ref": "#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bevel": {
          "type": "number",
          "minimum": 0
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rings": {
          "type": "integer",
          "minimum": 2
        },
        "segments": {
          "type": "integer",
          "minimum": 3
        },
        "subdivisions": {
          "type": "integer",
          "minimum": 0
        },
        "inward_facing": {
          "description": "Flips the winding and the normals, for a box used as a room rather than as a crate.",
          "type": "boolean"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "prefab": {
          "type": "string",
          "pattern": "^kit\\."
        },
        "mesh": {
          "$ref": "#/$defs/mesh"
        },
        "primitive": {
          "$ref": "#/$defs/primitive"
        },
        "material": {
          "description": "What the entity's mesh wears. On a prefab this overrides the kit piece's own material, for one-off dressing (a scorched wall, a mossy floor) without adding a kit entry. On a mesh or a primitive there is no kit entry to fall back on, so this is the material outright.",
          "type": "string",
          "minLength": 1
        },
        "cast_shadows": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "cell": {
          "description": "Authored grid placement for kit pieces that occupy a cell or a cell edge. The transform is derived from this; both are stored so re-editing never has to guess a cell back out of a world position.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "col",
            "row"
          ],
          "properties": {
            "col": {
              "type": "integer"
            },
            "row": {
              "type": "integer"
            },
            "edge": {
              "enum": [
                "north",
                "east",
                "south",
                "west"
              ]
            },
            "span": {
              "type": "integer",
              "minimum": 1
            },
            "yaw_quarters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "level": {
              "type": "number"
            }
          }
        },
        "collider": {
          "$ref": "#/$defs/collider"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "light": {
          "$ref": "#/$defs/light"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "first_person": {
          "$ref": "#/$defs/first_person"
        },
        "viewmodel_rig": {
          "$ref": "#/$defs/viewmodel_rig"
        },
        "viewmodel_preview": {
          "$ref": "#/$defs/viewmodel_preview"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "audio_listener": {
          "$ref": "#/$defs/audio_listener"
        },
        "scripts": {
          "type": "array",
          "description": "Lua scripts attached to this entity, in the order their callbacks run.",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Logical asset path, e.g. scripts/door.lua",
                "pattern": "\\.lua$"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "A disabled script is never instantiated."
              },
              "props": {
                "type": "object",
                "description": "Per-instance authored values, reachable as self.props.",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "description": "a vec3"
                    },
                    {
                      "type": "object",
                      "required": [
                        "entity"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "entity": {
                          "type": "string"
                        }
                      },
                      "description": "a reference to another entity, by name"
                    }
                  ]
                }
              }
            }
          }
        },
        "spin": {
          "$ref": "#/$defs/spin"
        },
        "player_spawn": {
          "type": "boolean"
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yaw_degrees"
          ],
          "properties": {
            "yaw_degrees": {
              "type": "number"
            }
          }
        },
        "enemy_spawn": {
          "type": "string",
          "minLength": 1
        },
        "pickup": {
          "type": "string",
          "minLength": 1
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "shader": {
          "$ref": "#/$defs/shader"
        },
        "portal": {
          "$ref": "#/$defs/portal"
        },
        "orbit": {
          "$ref": "#/$defs/orbit"
        },
        "particles": {
          "$ref": "#/$defs/particles"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "sounds": {
          "$ref": "#/$defs/sounds"
        }
      }
    },
    "shader": {
      "type": "object",
      "description": "Per-entity shader uniforms. Every field optional; omitted means the engine default, which renders exactly as an entity without the component.",
      "additionalProperties": false,
      "properties": {
        "tint": {
          "$ref": "#/$defs/vec3",
          "description": "multiplied into the albedo before lighting; white is unchanged"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rim_colour": {
          "$ref": "#/$defs/vec3",
          "description": "fresnel sheen at glancing angles"
        },
        "rim_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "rim_power": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 64,
          "description": "falloff: low is a broad wash, high a thin edge"
        },
        "alpha_scissor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "cutout threshold; below it the fragment is discarded"
        }
      }
    },
    "portal": {
      "type": "object",
      "description": "The portal shader's uniforms, on this entity. Keys are the uniform names -- see eng::ecs::PortalParams. Every one optional; omitted means the material's own default.",
      "additionalProperties": true
    },
    "orbit": {
      "description": "Travel around a point, without a pivot entity. Spin turns a thing where it stands; this moves it along a ring. The centre is in the entity's own frame -- its parent's, or the world when it has none.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "centre": {
          "$ref": "#/$defs/vec3"
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "degrees_per_second": {
          "type": "number"
        },
        "phase_degrees": {
          "description": "Where on the ring it starts. Two entities on one ring with the same rate and no phase occupy the same point forever.",
          "type": "number"
        },
        "height": {
          "description": "Along the axis from the centre: the ring's height above what it circles.",
          "type": "number"
        },
        "facing": {
          "description": "free keeps the authored rotation (and leaves it to Spin); centre looks at what it circles; travel looks along the direction of motion.",
          "enum": [
            "free",
            "centre",
            "travel"
          ]
        }
      }
    },
    "particles": {
      "type": "object",
      "description": "A particle effect playing from this entity. Keys are the fields of eng::ecs::ParticleEmitter.",
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "string",
          "description": "a name from the particle library; empty plays nothing"
        },
        "offset": {
          "$ref": "#/$defs/vec3"
        },
        "playing": {
          "type": "boolean"
        },
        "scale": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 16
        }
      }
    },
    "actor": {
      "description": "What the game treats this entity as. Gates the sound table and names its default cues (\"enemy.death\"). A player spawn, an enemy spawn or an \"enemy.\" marker already imply a kind; this states one outright, which is the only way to author an NPC.",
      "type": "string",
      "enum": [
        "player",
        "npc",
        "enemy"
      ]
    },
    "sounds": {
      "description": "One cue id from audio.toml per action this actor performs. An absent row falls back to the actor type's table, then to \"<kind>.<action>\", so an empty table changes nothing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spawn": {
          "type": "string"
        },
        "idle": {
          "type": "string"
        },
        "alert": {
          "type": "string"
        },
        "footstep": {
          "type": "string"
        },
        "jump": {
          "type": "string"
        },
        "land": {
          "type": "string"
        },
        "telegraph": {
          "type": "string"
        },
        "attack": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "hurt": {
          "type": "string"
        },
        "block": {
          "type": "string"
        },
        "dodge": {
          "type": "string"
        },
        "death": {
          "type": "string"
        },
        "interact": {
          "type": "string"
        }
      }
    }
  }
}
