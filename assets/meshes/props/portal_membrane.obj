# portal membrane -- the slab the portal shader draws on.
# Sized like the runtime prop it replaces (2.8 x 2.5 x 0.14 m), base
# at y=0 so it places like any other kit piece. A slab and not a sheet:
# edge on, a zero-thickness field vanishes, and its rim catches light
# against the arch.
o portal_membrane
v -1.4000 0.0000 -0.0700
v 1.4000 0.0000 -0.0700
v 1.4000 2.5000 -0.0700
v -1.4000 2.5000 -0.0700
v -1.4000 0.0000 0.0700
v 1.4000 0.0000 0.0700
v 1.4000 2.5000 0.0700
v -1.4000 2.5000 0.0700
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn 1.0 0.0 0.0
vn -1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1
f 2/1/2 1/2/2 4/3/2
f 2/1/2 4/3/2 3/4/2
f 6/1/3 2/2/3 3/3/3
f 6/1/3 3/3/3 7/4/3
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4
f 4/1/5 8/2/5 7/3/5
f 4/1/5 7/3/5 3/4/5
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
